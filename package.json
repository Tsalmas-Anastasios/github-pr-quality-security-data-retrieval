{
    "name": "github-pr-quality-security-data-retrieval",
    "version": "0.0.1",
    "description": "Functionality to get data from github, mainly data for pull requests",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": "./dist/index.js",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "tsx src/cli.ts",
        "job": "tsx src/cli.ts run",
        "jobs": "tsx src/cli.ts list",
        "github:check": "tsx src/cli.ts github-check",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/cli.js",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "npm run typecheck && npm run format:check && npm run build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Tsalmas-Anastasios/github-pr-quality-security-data-retrieval.git"
    },
    "keywords": [
        "software",
        "quality",
        "security",
        "pull-requests"
    ],
    "author": "Anastasios Tsalmas",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Tsalmas-Anastasios/github-pr-quality-security-data-retrieval/issues"
    },
    "homepage": "https://github.com/Tsalmas-Anastasios/github-pr-quality-security-data-retrieval#readme",
    "dependencies": {
        "commander": "^15.0.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^24.19.1",
        "prettier": "^3.9.9",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
