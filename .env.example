# Optional for public repositories; required for private repositories.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
# Optional; defaults to API_TIMEOUT_MS when unset.
# GITHUB_TIMEOUT_MS=30000
# The thesis project names also work as fallbacks:
# GITHUB_API__TOKEN=
# GITHUB_API__URL=https://api.github.com
# GITHUB_API__TIMEOUT=30000

OUTPUT_DIR=data/exports
LOG_LEVEL=info
API_TIMEOUT_MS=30000
API_RETRIES=3
# Fail with a useful error if a server asks for a longer wait.
API_MAX_RETRY_DELAY_MS=120000
